API_BASE_URL=https://api.example.com

# 로그인 서버 설정: 로컬 DataGSM callback도 등록해야 한다.
APP_ORIGIN=http://localhost:3100
DATAGSM_CLIENT_ID=replace-with-registered-client-id
DATAGSM_REDIRECT_URI=http://localhost:3100/api/auth/callback

# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이지 않는다.
JEB_API_KEY=replace-with-provider-key
UPSTASH_REDIS_REST_URL=https://replace-with-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-redis-token

# 운영·preview·개발이 같은 Redis 키를 공유하지 않도록 별도 지정한다.
REDIS_NAMESPACE=conch:v1:development
